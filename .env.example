# Configuração do projeto Firebase (Auth + Firestore + Storage).
# Crie um projeto em https://console.firebase.google.com, ative:
#   - Authentication > Sign-in method > Google
#   - Firestore Database (modo produção)
#   - Storage
# Depois copie as credenciais do app web (Configurações do projeto > Seus apps)
# para um arquivo `.env.local` (nunca commitado) com os valores reais.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
