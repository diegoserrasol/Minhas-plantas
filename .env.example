# Configuração do projeto Firebase (Auth + Firestore).
# Crie um projeto em https://console.firebase.google.com, ative:
#   - Authentication > Sign-in method > Google
#   - Firestore Database (modo produção)
# Fotos são salvas como base64 direto no Firestore, não usa Firebase Storage.
# Depois copie as credenciais do app web (Configurações do projeto > Seus apps)
# para um arquivo `.env.local` (nunca commitado) com os valores reais.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
