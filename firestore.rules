rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownerMatchesBody(uid) {
      return request.resource.data.userId == uid;
    }

    function hasNonEmptyName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    // Cover photos are base64 data URIs inline on the document — same
    // 1 MiB Firestore document cap as standalone photos applies here.
    // The `is string` guard matters: calling size() on a null or numeric
    // field aborts rule evaluation and shows up as permission-denied.
    function hasValidCoverPhoto() {
      return !('coverPhotoUrl' in request.resource.data)
        || (request.resource.data.coverPhotoUrl is string
            && request.resource.data.coverPhotoUrl.size() < 900000);
    }

    // On update, request.resource.data is the *merged* document, so an
    // oversized cover written by an older client would fail this check on
    // every later write — permanently blocking unrelated edits such as
    // linking the plant to a group. Only validate a cover that's actually
    // changing.
    function coverPhotoWriteOk() {
      return hasValidCoverPhoto()
        || request.resource.data.get('coverPhotoUrl', '')
             == resource.data.get('coverPhotoUrl', '');
    }

    function exactlyOneTarget() {
      let hasPlant = ('plantId' in request.resource.data)
        && request.resource.data.plantId is string;
      let hasGroup = ('groupId' in request.resource.data)
        && request.resource.data.groupId is string;
      return hasPlant != hasGroup;
    }

    match /users/{uid} {
      allow read, update: if isOwner(uid);
      allow create: if isOwner(uid);
      allow delete: if false;

      // Read/delete rely only on the path-based `isOwner(uid)` check —
      // NOT on resource.data — because Firestore rejects any unfiltered
      // `list` query whose rule depends on resource.data unless the
      // query itself is constrained by a matching where() clause. Our
      // isolation is already structural (subcollection under users/{uid}),
      // so resource.data.userId is only meaningful — and only checked —
      // on writes, where it can't break listing.
      match /plants/{plantId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && ownerMatchesBody(uid) && hasNonEmptyName()
          && hasValidCoverPhoto();
        allow update: if isOwner(uid) && request.resource.data.userId == uid
          && coverPhotoWriteOk();
      }

      match /groups/{groupId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && ownerMatchesBody(uid) && hasNonEmptyName()
          && hasValidCoverPhoto();
        allow update: if isOwner(uid) && request.resource.data.userId == uid
          && coverPhotoWriteOk();
      }

      match /products/{productId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && ownerMatchesBody(uid) && hasNonEmptyName()
          && request.resource.data.type in ['mineral', 'biologico'];
        allow update: if isOwner(uid) && request.resource.data.userId == uid
          && (!('type' in request.resource.data) || request.resource.data.type in ['mineral', 'biologico']);
      }

      match /careCycles/{cycleId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && ownerMatchesBody(uid)
          && request.resource.data.frequencyValue is number
          && request.resource.data.frequencyValue > 0
          && request.resource.data.frequencyUnit in ['dias', 'semanas', 'meses']
          && exactlyOneTarget();
        allow update: if isOwner(uid) && request.resource.data.userId == uid;
      }

      match /applications/{applicationId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && ownerMatchesBody(uid)
          && request.resource.data.productId is string
          && exactlyOneTarget();
        // Applications are immutable once registered — the cycle-rollover
        // rule (PRD §20) depends on the history staying exactly as recorded.
        allow update: if false;
      }

      match /photos/{photoId} {
        allow read, delete: if isOwner(uid);
        // Photos are base64 data URIs inline in the document (no Storage
        // bucket) — cap url length so a buggy client can't skip
        // compression and blow past Firestore's 1 MiB document limit.
        allow create: if isOwner(uid) && ownerMatchesBody(uid)
          && request.resource.data.plantId is string
          && request.resource.data.url is string
          && request.resource.data.url.size() < 900000;
        allow update: if false;
      }
    }

    match /recommendations/{recommendationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
